terraform {
  required_version = ">= 1.5.0"

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = "~> 5.0"
    }
  }
}

provider "oci" {
  region = var.region
  # Auth comes from the standard OCI CLI config file (~/.oci/config),
  # created manually via `oci setup config`. Never generated by this project.
}
